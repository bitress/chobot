# ==============================================================================
# SysBot Bridge & Cloudflare Tunnel Gateway Configuration
# ==============================================================================

# Local Bridge Port (Default: 127.0.0.1 so only Cloudflare Tunnel and local processes can connect)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8200

# Secret Key required for incoming requests from VPS (Bearer Token or X-API-Key)
# Set this to a strong random token and set the same in your VPS chobot .env (SYSBOT_API_KEY)
SYSBOT_API_KEY=chopaeng_secret_bridge_token_2026

# Optional Cloudflare Access Service Token validation (secondary security layer)
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Optional CORS origin (leave empty to disable CORS headers entirely)
# CORS_ORIGIN=

# Base Port for the 48 islands (8201..8248)
SYSBOT_BASE_PORT=8201
SYSBOT_LOCAL_HOST=127.0.0.1

# Optional individual port overrides if any island uses a custom port:
# SYSBOT_PORT_HIRAYA=8201
# SYSBOT_PORT_SINTA=8248
